{
  "expo": {
    "name": "Warranty Keeper",
    "slug": "warranty-keeper",
    "scheme": "warrantykeeper",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pomwik.warranty"
    },
    "android": {
      "package": "com.pomwik.warranty",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "fr"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app lets you attach a photo of your receipt to an item.",
          "cameraPermission": "The app lets you take a photo of your receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6F4A"
        }
      ],
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextWarranty",
              "label": "@string/widget_next_warranty_label",
              "description": "@string/widget_next_warranty_desc",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            }
          ]
        }
      ],
      "./plugins/withWidgetStrings"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
